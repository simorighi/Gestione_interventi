# ==============================================================================
# DOCUMENTAZIONE VARIABILI D'AMBIENTE
# Copia questo file in .env e inserisci i valori reali. 
# ATTENZIONE: NON committare MAI il file .env nel repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE (Supabase / Prisma)
# ------------------------------------------------------------------------------
# Stringa di connessione Postgres di Supabase.
# Percorso: Supabase > Project Settings > Database > Connection string
# Usata sia dall'app (src/server/db.ts) sia dalla CLI Prisma (migrate, studio, seed).
# Nota: Le migrazioni non funzionano dal pooler in transaction mode (porta 6543):
# per migrate usa la connessione diretta o il session pooler (porta 5432).
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# SERVER & APPLICATIVO
# ------------------------------------------------------------------------------
# Porta su cui il backend resta in ascolto. 
PORT=8080

# Livello di dettaglio dei log (debug, info, warn, error)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# INTEGRAZIONE E SICUREZZA
# ------------------------------------------------------------------------------
# Origine del frontend accettata dal backend. Obbligatoria per evitare errori CORS.
# In DEV (locale) usare tipicamente http://localhost:5173
# In TEST/PROD usare il dominio reale (es. https://test.nordfacility.it)
CORS_ORIGIN="http://localhost:5173"
