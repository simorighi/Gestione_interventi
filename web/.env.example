# ==============================================================================
# DOCUMENTAZIONE VARIABILI D'AMBIENTE
# Copia questo file in .env e inserisci i valori reali. 
# ATTENZIONE: NON committare MAI il file .env nel repository.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE (Supabase / Prisma)
# ------------------------------------------------------------------------------
# Stringa di connessione Postgres di Supabase.
# Percorso: Supabase > Project Settings > Database > Connection string
# Usata sia dall'app (src/server/db.ts) sia dalla CLI Prisma (migrate, studio, seed).
# Nota: Le migrazioni non funzionano dal pooler in transaction mode (porta 6543):
# per migrate usa la connessione diretta o il session pooler (porta 5432).
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# SERVER & APPLICATIVO
# ------------------------------------------------------------------------------
# Porta su cui il backend resta in ascolto. 
PORT=3000

# Durata del token di accesso in minuti (default 480 = 8 ore).
AUTH_TOKEN_TTL_MIN=480

# Livello di dettaglio dei log (debug, info, warn, error)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# INTEGRAZIONE E SICUREZZA
# ------------------------------------------------------------------------------
# Chiave segreta con cui il backend firma i token di login. OBBLIGATORIA,
# almeno 32 caratteri, diversa per ogni ambiente. Generarla con:
#   openssl rand -base64 48
AUTH_SECRET="[GENERARE-CON-openssl-rand-base64-48]"

# Origini del frontend autorizzate a chiamare l'API da un ALTRO dominio
# (separate da virgola). FACOLTATIVA: con il proxy di Vite in sviluppo e con
# l'Ingress nel cluster frontend e API hanno la stessa origine e CORS non serve.
# Esempio se il frontend gira su un dominio diverso: http://localhost:5173
CORS_ORIGIN=""
