# Ambiente TEST: usare questi valori come base per Secret/ConfigMap Kubernetes.
# DATABASE_URL e AUTH_SECRET vanno nel Secret (k8s/secret-example.yaml), mai nel repository.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[TEST-PROJECT-REF].supabase.co:5432/postgres"
AUTH_SECRET="[GENERARE-CON-openssl-rand-base64-48]"
AUTH_TOKEN_TTL_MIN=480
PORT=3000
LOG_LEVEL=info
# Vuota: dietro l'Ingress frontend e API hanno la stessa origine.
CORS_ORIGIN=""
