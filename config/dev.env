# Sviluppo locale: copiare in web/.env e sostituire i placeholder.
# Non inserire mai credenziali reali in questo file.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[DEV-PROJECT-REF].supabase.co:5432/postgres"
AUTH_SECRET="[GENERARE-CON-openssl-rand-base64-48]"
AUTH_TOKEN_TTL_MIN=480
PORT=3000
LOG_LEVEL=debug
# Vuota: il frontend (Vite, :5173) chiama /api tramite il proxy, stessa origine.
CORS_ORIGIN=""
